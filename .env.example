# Copy to .env and edit. Nothing here is a secret by default; keep real tokens out of git.
COD_RGB_CHECKPOINT=checkpoints/rgb_best.pt          # RGB-only checkpoint (optional)
COD_MM_CHECKPOINT=checkpoints/multimodal_best.pt    # depth-fusion checkpoint (optional)
COD_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
COD_DEVICE=auto                                     # auto | cuda | mps | cpu
COD_MAX_UPLOAD_MB=10
COD_MAX_SIDE=4096
COD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# COD_FRONTEND_DIR=frontend/dist                    # serve the built UI from FastAPI
# HF_HOME=~/.cache/huggingface
